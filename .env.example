# Gateway Configuration
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# Required: Your gateway endpoint URL
# This should be the URL of your agent gateway
GATEWAY_URL=https://your-gateway-url.openai.azure.com/

# Required: API key for authentication to the gateway
# You can find this in your Azure portal under the agent gateway resource
GATEWAY_KEY=your-api-key-here

# Optional: Model configuration
# If not set, defaults to gpt-4o
MODEL_NAME=gpt-4o

# Optional: Log level configuration
# If not set, defaults to Information
# LOG_LEVEL=Information

# =====================================================================
# OpenTelemetry (OTel) Distributed Tracing Configuration
# Compatible with any standard OTLP collector: Langfuse, SigNoz, Jaeger, Aspire
# =====================================================================

# Required: OTLP Exporter Endpoint URL
# Default (Self-hosted Langfuse): https://dev-monitoring.pronative.ai/api/public/otel
# Example (SigNoz Cloud): https://ingest.signoz.io:443
# Example (Local OTel Collector / Jaeger): http://localhost:4318/v1/traces
# [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes("pk-lf-...:sk-lf-..."))
OTEL_EXPORTER_OTLP_ENDPOINT=https://dev-monitoring.pronative.ai/api/public/otel

# Optional: OTLP Exporter Authentication / Custom Headers
# For Langfuse: Authorization=Basic <base64(public_key:secret_key)>
# For SigNoz:   signoz-access-token=<your-signoz-token>
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64(pk:sk)>,x-langfuse-ingestion-version=4"

# Optional: OpenTelemetry Service Name
# If not set, defaults to loop-vs-graph
OTEL_SERVICE_NAME=graph-engineering
