<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AksAgenticWorkflowConsole</RootNamespace>
    <AssemblyName>AksAgenticWorkflowConsole</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.0.0-beta.2" />
    <PackageReference Include="Azure.Identity" Version="1.12.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.0.0-preview.251001.3" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.0.0-preview.251001.3" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\.env" CopyToOutputDirectory="PreserveNewest" Link=".env" Condition="Exists('..\..\.env')" />
  </ItemGroup>

</Project>
